{
  "permissions": {
    "allow": [
      "Bash(aedile/recap/call.sh get:*)",
      "Bash(aedile/recap/call.sh readThread:*)",
      "Bash(aedile/recap/call.sh readInbox:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(git push:*)",
      "Bash(clasp -u aedile deploy:*)",
      "Bash(clasp -u aedile deployments:*)",
      "Bash(clasp -u aedile pull:*)",
      "Bash(clasp -u aedile push:*)",
      "Bash(node --check:*)",
      "Bash(node aedile/TestsLocal.js)"
    ],
    "ask": [
      "Bash(clasp -u aedile version:*)",
      "Bash(aedile/recap/call.sh scanInbox:*)",
      "Bash(aedile/recap/call.sh checkBumps:*)",
      "Bash(aedile/recap/call.sh createDraft:*)",
      "Bash(aedile/recap/call.sh sendReplyAll:*)",
      "Bash(aedile/recap/call.sh setRecapEnabled:*)",
      "Bash(aedile/recap/redige.mjs:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qE 'redige\\.mjs|call\\.sh +(createDraft|sendReplyAll|trashMessage|scanInbox|checkBumps|setRecapEnabled)' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"Spends the krewe API budget and can post or send mail from the aedile mailbox.\"}}' || true"
          }
        ]
      }
    ]
  }
}
