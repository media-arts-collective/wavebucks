[Unit]
Description=krewe: refresh the mailing-list corpus (scrape, merge, gate, install)
Documentation=https://github.com/media-arts-collective/wavebucks/issues/93
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/state/vim-arcade/spawn/media-arts-collective__wavebucks/aedile/analysis/corpus-refresh.sh
# A first scrape is hours (628 topics, 40 a chunk, ten minutes between); a
# refresh with a full ledger is minutes.
TimeoutStartSec=8h
Nice=10
# Any exit but 0 reaches the desktop: 3 needs a sign-in, 4 the gate refused,
# anything else died before it could say. A status file nobody opens is how
# the scrape sat for ten days (#93 item 1).
ExecStopPost=/bin/sh -c '[ "$EXIT_STATUS" = 0 ] || notify-send -u critical "krewe corpus refresh: exit $EXIT_STATUS" "$(cat %S/krewe/corpus-refresh/status)"'
